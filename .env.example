# Uptime Monitor configuration
# Copy to .env and adjust as needed:  cp .env.example .env

# HTTP port and bind address
PORT=3000
HOST=0.0.0.0

# Directory where the SQLite database is stored
DATA_DIR=./data

# Optional authentication. When BOTH are set, the web UI and API require
# HTTP Basic auth. Leave empty for open (local/trusted) access.
# API keys created in the UI/API provide a second authentication method.
ADMIN_USER=
ADMIN_PASSWORD=

# Set to true to allow monitoring private/internal networks (10.x, 192.168.x,
# 127.x, link-local, etc.). Off by default to prevent SSRF misuse.
ALLOW_PRIVATE_NETWORKS=false

# How many days of raw check data to keep. Older checks are pruned on a schedule.
CHECK_RETENTION_DAYS=90

# How often (minutes) the retention pruner runs.
CHECK_RETENTION_INTERVAL_MINUTES=60

# Optional default SMTP server for email notifications. Individual
# notifications can override host/port/from when created in the UI.
# SMTP_PORT defaults to 587; set SMTP_SECURE=true for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
